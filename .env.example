# ========================================================
# CONFIGURAÇÕES DO TELEGRAM DEAL BOT (BOT OF BOTS)
# ========================================================

# Credenciais oficiais da sua conta Telegram (obtenha em https://my.telegram.org)
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# String de sessão persistente Telethon (gerada com python scripts/gerar_sessao.py)
# NUNCA compartilhe esta string ou faça commit deste arquivo!
TELEGRAM_STRING_SESSION=

# Destino dos Alertas:
# - ID numérico de Canal/Grupo (ex: -1001234567890) -> RECOMENDADO para som/push!
# - 'me' -> Envia silenciosamente para suas Mensagens Salvas
ALERT_DESTINATION=-1001234567890

# Token do Bot criado no @BotFather (necessário para som/push e comandos via Telegram)
# Formato: 1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_TOKEN=

# ID numérico do Administrador (apenas este usuário pode rodar comandos admin no Telegram)
ADMIN_USER_ID=

# Multi-usuário & Deduplicação
MAX_TERMS_PER_USER=5
DEDUP_WINDOW_MINUTES=30
REQUIRE_PRICE_FOR_CAP=true

# Dashboard Web (FastAPI)
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8086
WEB_PASSWORD=

# Armazenamento e Palavras-Chave
DB_PATH=data/deals.db
KEYWORDS_FILE=keywords.txt
TZ=America/Sao_Paulo

# Canais Temáticos Opcionais (deixe vazio para desabilitar)
CHANNEL_HARDWARE=
CHANNEL_PERIFERICOS=
CHANNEL_GAMES=

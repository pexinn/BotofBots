# ========================================================
# CONFIGURAÇÕES DO TELEGRAM DEAL BOT
# ========================================================

# Credenciais oficiais da sua conta Telegram (obtenha em https://my.telegram.org)
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# String de sessão persistente Telethon (gerada com python scripts/gerar_sessao.py)
# NUNCA compartilhe esta string ou faça commit deste arquivo!
TELEGRAM_STRING_SESSION=

# Destino dos Alertas:
# - ID numérico de Canal/Grupo (ex: -1001234567890) -> RECOMENDADO para som/push!
# - 'me' -> Envia silenciosamente para suas Mensagens Salvas
ALERT_DESTINATION=-1001234567890

# Token do Bot criado no @BotFather (necessário para o celular apitar e vibrar)
# Formato: 1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_TOKEN=

